---
// src/layouts/Layout.astro
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="A premium, Vercel-inspired productivity todo backlog and Pomodoro focus timer application." />
		<title>FocusFlow — Productivity Dashboard</title>

		<!-- Preload Google Fonts for Inter and JetBrains Mono -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">

		<!-- Inline theme initializer to prevent Flash of Unstyled Content (FOUC) -->
		<script is:inline>
			(function() {
				const saved = localStorage.getItem('vercel-todo-theme');
				const system = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
				const theme = saved || system;
				if (theme === 'dark') {
					document.documentElement.classList.add('dark');
				} else {
					document.documentElement.classList.remove('dark');
				}
			})();
		</script>
	</head>
	<body class="bg-canvas-soft text-ink min-h-screen flex flex-col antialiased transition-colors duration-200">
		<slot />
	</body>
</html>

