---
// Header.astro
// Props or imports can go here if needed.
---

<header
  class="sticky top-0 z-40 w-full h-[72px] border-b border-hairline/80 bg-canvas/80 backdrop-blur-md px-6 sm:px-8 transition-colors duration-200"
>
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between">
    <!-- Logo & Brand -->
    <div class="flex items-center gap-3">
      <a
        href="/"
        class="flex items-center gap-2 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-link focus-visible:ring-offset-2 rounded-sm"
        aria-label="Zenith Home"
      >
        <span class="text-brand-pink font-bold text-lg select-none">✦</span>
        <span class="font-sans font-bold tracking-tight text-sm text-ink"
          >Zenith.</span
        >
      </a>
      <span
        class="font-mono text-[9px] font-semibold text-mute border border-hairline px-1.5 py-0.5 rounded bg-canvas-soft select-none"
        >V1.0.0</span
      >
    </div>

    <!-- Central Navigation Links (Capsule Dock style) -->
    <nav
      class="hidden md:flex items-center gap-1 bg-canvas-soft border border-hairline rounded-full p-1 shadow-inner"
      aria-label="Main Navigation"
    >
      <a
        href="#dashboard"
        class="px-4 py-1 rounded-full text-xs font-semibold text-ink bg-canvas shadow-sm transition-all"
      >
        Dashboard
      </a>
      <a
        href="#pomodoro"
        class="px-4 py-1 rounded-full text-xs font-semibold text-body hover:text-ink hover:bg-canvas transition-all"
      >
        Focus Timer
      </a>
      <a
        href="#analytics"
        class="px-4 py-1 rounded-full text-xs font-semibold text-body hover:text-ink hover:bg-canvas transition-all"
      >
        Analytics
      </a>
    </nav>

    <!-- Right-side Actions Cluster -->
    <div class="flex items-center gap-2 sm:gap-3">
      <!-- Command Palette Search Button (SEARCH ⌘K badge) -->
      <button
        id="cmd-palette-trigger"
        class="flex items-center gap-1.5 h-8 px-2 border border-hairline bg-canvas hover:bg-canvas-soft rounded text-[10px] font-mono text-mute hover:text-ink transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-link focus-visible:ring-offset-2 cursor-pointer"
        aria-label="Open command palette"
      >
        <svg class="h-3.5 w-3.5 text-mute" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <span class="hidden sm:inline">SEARCH</span>
        <kbd
          class="hidden sm:inline font-sans text-[9px] font-bold border border-hairline-strong/20 px-1 rounded bg-canvas shadow-sm select-none"
          >⌘K</kbd
        >
      </button>

      <!-- Theme Switcher Button -->
      <button
        id="theme-toggle"
        class="relative flex h-8 w-8 items-center justify-center border border-hairline bg-canvas hover:bg-canvas-soft rounded-full transition-all text-body hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-link focus-visible:ring-offset-2 cursor-pointer"
        aria-label="Toggle visual theme"
      >
        <!-- Sun Icon (Light Mode) -->
        <svg
          id="theme-sun"
          class="absolute h-4 w-4 scale-0 rotate-90 transition-all duration-300 dark:scale-100 dark:rotate-0"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m0-12.728l.707.707m12.728 12.728l.707-.707M12 8a4 4 0 100 8 4 4 0 000-8z"
          ></path>
        </svg>
        <!-- Moon Icon (Dark Mode) -->
        <svg
          id="theme-moon"
          class="absolute h-4 w-4 scale-100 rotate-0 transition-all duration-300 dark:scale-0 dark:rotate-90"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
          ></path>
        </svg>
      </button>

      <!-- Import/Export settings dialog trigger -->
      <button
        id="backup-menu-trigger"
        class="flex h-8 w-8 items-center justify-center border border-hairline bg-canvas hover:bg-canvas-soft rounded-full transition-all text-body hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-link focus-visible:ring-offset-2 cursor-pointer"
        aria-label="Database import export settings"
      >
        <svg
          class="h-4.5 w-4.5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4"
          ></path>
        </svg>
      </button>

      <!-- Solid Black + New task button -->
      <button
        id="header-new-task-btn"
        class="h-8 w-8 sm:w-auto sm:px-4 rounded-md bg-primary hover:bg-primary/90 text-on-primary font-sans text-xs font-semibold hover:scale-[1.02] active:scale-[0.98] transition-all flex items-center justify-center gap-1 cursor-pointer shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-pink"
      >
        <svg
          class="h-3.5 w-3.5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2.5"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M12 4v16m8-8H4"></path>
        </svg>
        <span class="hidden sm:inline">New task</span>
      </button>
    </div>
  </div>
</header>

<script>
  // @ts-nocheck
  import { TodoStore } from "../scripts/store.js";

  // Initialize theme button triggers
  const themeToggle = document.getElementById("theme-toggle");

  if (themeToggle) {
    themeToggle.addEventListener("click", () => {
      const currentTheme = TodoStore.getTheme();
      const nextTheme = currentTheme === "dark" ? "light" : "dark";
      TodoStore.setTheme(nextTheme);
    });
  }

  // Active navigation highlight listener based on hash links
  window.addEventListener("hashchange", () => {
    const hash = window.location.hash || "#dashboard";
    const navLinks = document.querySelectorAll("nav a");

    navLinks.forEach((link) => {
      const href = link.getAttribute("href");
      if (href === hash) {
        link.classList.add("text-ink", "bg-canvas", "shadow-sm");
        link.classList.remove("text-body", "hover:text-ink");
      } else {
        link.classList.remove("text-ink", "bg-canvas", "shadow-sm");
        link.classList.add("text-body", "hover:text-ink");
      }
    });
  });

  // Bind New task button
  const newTaskBtn = document.getElementById("header-new-task-btn");
  if (newTaskBtn) {
    newTaskBtn.addEventListener("click", () => {
      window.dispatchEvent(new CustomEvent("task-modal:open"));
    });
  }
</script>
