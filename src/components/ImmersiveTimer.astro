---
// ImmersiveTimer.astro
---

<div class="relative w-full max-w-4xl mx-auto bg-canvas border border-hairline rounded-xl p-8 md:p-12 shadow-level-4 flex flex-col items-center justify-between min-h-[500px] overflow-hidden transition-all duration-200">
  
  <!-- Ambient backdrop glows -->
  <div class="absolute inset-0 bg-gradient-to-tr from-brand-violet/5 via-brand-pink/5 to-transparent pointer-events-none z-0"></div>

  <!-- Header info and task selector row -->
  <div class="w-full flex flex-col md:flex-row items-center justify-between gap-4 border-b border-hairline pb-6 z-10 relative">
    <div class="flex items-center gap-2">
      <span class="inline-flex h-3 w-3 rounded-full bg-brand-pink animate-ping" id="imm-status-dot"></span>
      <span class="font-mono text-xs uppercase tracking-wider text-body" id="imm-status-label">Ready to Focus.</span>
    </div>

    <!-- Active task selector -->
    <div class="flex items-center gap-2">
      <label for="imm-task-select" class="font-mono text-[10px] uppercase text-mute whitespace-nowrap">Lock Task:</label>
      <select 
        id="imm-task-select" 
        class="bg-canvas-soft border border-hairline rounded-md px-3 py-1.5 text-xs text-ink font-sans focus:outline-none focus:ring-1 focus:ring-brand-pink cursor-pointer max-w-[240px] truncate"
      >
        <option value="">-- Select a Task --</option>
      </select>
    </div>
  </div>

  <!-- Big Clock Timer -->
  <div class="my-10 md:my-14 flex flex-col items-center z-10 relative select-none">
    <div id="imm-clock-display" class="relative group cursor-pointer hover:bg-canvas-soft-2/80 rounded-2xl px-6 py-2.5 transition-all" title="Click to set custom timer duration">
      <span 
        id="imm-clock" 
        class="font-mono text-7xl sm:text-8xl md:text-[10rem] font-bold tracking-tighter tabular-nums text-ink drop-shadow-sm transition-all leading-none duration-500 ease-out"
      >
        25:00
      </span>
      <!-- Small edit pencil indicator -->
      <span class="absolute -top-1 -right-1 opacity-0 group-hover:opacity-100 transition-opacity text-body bg-canvas border border-hairline p-1.5 rounded-full shadow-sm scale-90">
        <svg class="h-4.5 w-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
        </svg>
      </span>
    </div>
    
    <!-- Edit form, hidden by default -->
    <form id="imm-edit-form" class="hidden justify-center items-center gap-2 mt-2">
      <input 
        type="number" 
        id="imm-edit-input" 
        min="1" max="180" 
        class="w-36 bg-canvas-soft border border-hairline rounded-md text-6xl sm:text-7xl font-mono font-bold text-ink text-center focus:ring-1 focus:ring-brand-pink focus:outline-none py-2"
        value="25"
      />
      <span class="text-sm sm:text-base text-mute font-mono font-semibold">MIN</span>
      <button type="submit" class="ml-3 p-2 rounded-full bg-primary text-on-primary hover:scale-105 active:scale-95 transition-all cursor-pointer shadow-sm" aria-label="Save time">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
        </svg>
      </button>
    </form>

    <!-- Active task title subtitle -->
    <p id="imm-task-title" class="font-sans text-sm sm:text-base text-body text-center mt-6 max-w-lg font-medium">
      Select a task to unlock focus mode.
    </p>
  </div>

  <!-- Controls Section (Ambient mixer removed) -->
  <div class="w-full max-w-md mx-auto pt-6 border-t border-hairline z-10 relative flex flex-col gap-4">
    
    <!-- Controls Stack -->
    <div class="flex flex-col gap-3 justify-center">
      <div class="flex items-center gap-3">
        <!-- Main Play/Pause Button -->
        <button 
          id="imm-control-btn"
          class="flex-1 h-12 rounded-full bg-primary text-on-primary font-sans text-sm font-semibold hover:scale-[1.02] active:scale-[0.98] transition-all flex items-center justify-center gap-2 cursor-pointer shadow-md focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-pink"
        >
          <svg id="imm-play-icon" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M8 5v14l11-7z" />
          </svg>
          <svg id="imm-pause-icon" class="h-5 w-5 hidden" fill="currentColor" viewBox="0 0 24 24">
            <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z" />
          </svg>
          <span id="imm-control-label">Start Focus</span>
        </button>

        <!-- Reset Button -->
        <button 
          id="imm-reset-btn"
          class="h-12 w-12 flex items-center justify-center rounded-full bg-canvas border border-hairline hover:bg-canvas-soft text-body hover:text-ink transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-pink"
          aria-label="Reset timer"
          title="Reset timer"
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M23 4v6h-6"></path>
            <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
          </svg>
        </button>
      </div>

      <!-- Quick duration shortcuts -->
      <div class="flex gap-2 justify-center">
        <button id="btn-set-focus" class="flex-1 py-1 rounded border border-hairline hover:bg-canvas-soft text-[10px] font-mono text-mute hover:text-ink transition-all cursor-pointer focus:outline-none">25m Work</button>
        <button id="btn-set-break" class="flex-1 py-1 rounded border border-hairline hover:bg-canvas-soft text-[10px] font-mono text-mute hover:text-ink transition-all cursor-pointer focus:outline-none">5m Break</button>
        <button id="btn-set-long" class="flex-1 py-1 rounded border border-hairline hover:bg-canvas-soft text-[10px] font-mono text-mute hover:text-ink transition-all cursor-pointer focus:outline-none">15m Break</button>
      </div>
    </div>

  </div>

</div>

<script>
  // @ts-nocheck
  import { TodoStore } from '../scripts/store.js';

  // Config bounds with localStorage persistence helper
  function getCustomTime(key, defaultVal) {
    if (typeof window === 'undefined') return defaultVal;
    return parseInt(localStorage.getItem(key) || defaultVal.toString());
  }

  let FOCUS_SECS = getCustomTime('vercel-custom-focus', 25 * 60);
  let BREAK_SECS = getCustomTime('vercel-custom-break', 5 * 60);
  let LONG_SECS = 15 * 60; // Standard 15m break remains standard or configurable

  let currentSecs = FOCUS_SECS;
  let isTimerRunning = false;
  let intervalId = null;
  let activeMode = 'focus'; // 'focus' | 'break'

  // Web Audio Context variables (Only for completion chime)
  let audioCtx = null;

  // DOM Elements selectors
  const clock = document.getElementById('imm-clock');
  const clockDisplay = document.getElementById('imm-clock-display');
  const editForm = document.getElementById('imm-edit-form');
  const editInput = document.getElementById('imm-edit-input');
  
  const taskSelect = document.getElementById('imm-task-select');
  const taskTitle = document.getElementById('imm-task-title');
  const statusDot = document.getElementById('imm-status-dot');
  const statusLabel = document.getElementById('imm-status-label');
  const controlBtn = document.getElementById('imm-control-btn');
  const playIcon = document.getElementById('imm-play-icon');
  const pauseIcon = document.getElementById('imm-pause-icon');
  const controlLabel = document.getElementById('imm-control-label');
  const resetBtn = document.getElementById('imm-reset-btn');
  
  const setFocusBtn = document.getElementById('btn-set-focus');
  const setBreakBtn = document.getElementById('btn-set-break');
  const setLongBtn = document.getElementById('btn-set-long');

  // Format Helper
  function format(seconds) {
    const m = Math.floor(seconds / 60).toString().padStart(2, '0');
    const s = (seconds % 60).toString().padStart(2, '0');
    return `${m}:${s}`;
  }

  // Hydrate Task Select lists
  function populateTasksList() {
    if (!taskSelect) return;
    const todos = TodoStore.getTodos().filter(t => !t.completed);
    const lockedId = TodoStore.getActiveFocusTodoId();

    const options = todos.map(todo => `
      <option value="${todo.id}" ${todo.id === lockedId ? 'selected' : ''}>
        #${todo.category} — ${todo.title}
      </option>
    `);
    
    taskSelect.innerHTML = `<option value="">-- Select a Task --</option>` + options.join('');
    syncTaskDisplay();
  }

  // Synchronize Active Task displays
  function syncTaskDisplay() {
    const todos = TodoStore.getTodos();
    const lockedId = TodoStore.getActiveFocusTodoId();

    if (lockedId) {
      const todo = todos.find(t => t.id === lockedId);
      if (todo) {
        if (taskTitle) taskTitle.innerHTML = `Locked focus target:<br/><strong class="text-ink font-semibold mt-1 inline-block text-base">${todo.title}</strong>`;
        if (taskSelect) taskSelect.value = lockedId;
        return;
      }
    }
    
    if (taskTitle) taskTitle.textContent = "Select a task to unlock focus mode.";
    if (taskSelect) taskSelect.value = "";
  }

  // Update clock visuals
  function render() {
    if (clock) {
      clock.textContent = format(currentSecs);
      
      // Update page tab title to show remaining time
      const prefix = isTimerRunning ? `(${format(currentSecs)}) ` : '';
      const modeLabel = activeMode === 'focus' ? 'Focusing' : 'Break';
      document.title = `${prefix}${modeLabel} - Zenith`;

      // Apply pulsing red/teal color based on mode and timer status
      if (isTimerRunning) {
        if (activeMode === 'focus') {
          clock.className = "font-mono text-7xl sm:text-8xl md:text-[10rem] font-bold tracking-tighter tabular-nums text-brand-pink drop-shadow-md transition-colors duration-500 animate-pulse";
        } else {
          clock.className = "font-mono text-7xl sm:text-8xl md:text-[10rem] font-bold tracking-tighter tabular-nums text-brand-cyan drop-shadow-md transition-colors duration-500 animate-pulse";
        }
      } else {
        clock.className = "font-mono text-7xl sm:text-8xl md:text-[10rem] font-bold tracking-tighter tabular-nums text-ink drop-shadow-sm transition-colors duration-500";
      }
    }

    if (statusLabel) {
      if (isTimerRunning) {
        statusLabel.textContent = activeMode === 'focus' ? 'FOCUSING IN PROGRESS.' : 'ON BREAK.';
      } else {
        statusLabel.textContent = 'READY TO FOCUS.';
      }
    }

    if (statusDot) {
      if (isTimerRunning) {
        statusDot.className = activeMode === 'focus' ? 'inline-flex h-3 w-3 rounded-full bg-brand-pink animate-ping' : 'inline-flex h-3 w-3 rounded-full bg-brand-cyan animate-ping';
      } else {
        statusDot.className = activeMode === 'focus' ? 'inline-flex h-3 w-3 rounded-full bg-brand-pink/50' : 'inline-flex h-3 w-3 rounded-full bg-brand-cyan/50';
      }
    }

    if (controlLabel && playIcon && pauseIcon) {
      if (isTimerRunning) {
        playIcon.classList.add('hidden');
        pauseIcon.classList.remove('hidden');
        controlLabel.textContent = 'Pause Focus';
      } else {
        playIcon.classList.remove('hidden');
        playIcon.classList.remove('hidden');
        pauseIcon.classList.add('hidden');
        controlLabel.textContent = activeMode === 'focus' ? 'Start Focus' : 'Start Break';
      }
    }
  }

  // Synthesize notification chime on end
  function playCompletionChime() {
    try {
      if (!audioCtx) {
        audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      }
      if (!audioCtx) return;
      
      if (audioCtx.state === 'suspended') audioCtx.resume();

      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      
      osc.connect(gain);
      gain.connect(audioCtx.destination);
      
      osc.type = 'triangle';
      osc.frequency.setValueAtTime(587.33, audioCtx.currentTime); // D5
      osc.frequency.setValueAtTime(880.00, audioCtx.currentTime + 0.15); // A5
      
      gain.gain.setValueAtTime(0, audioCtx.currentTime);
      gain.gain.linearRampToValueAtTime(0.25, audioCtx.currentTime + 0.05);
      gain.gain.exponentialRampToValueAtTime(0.0001, audioCtx.currentTime + 0.6);
      
      osc.start(audioCtx.currentTime);
      osc.stop(audioCtx.currentTime + 0.7);
    } catch (e) {
      console.warn("Chime failed", e);
    }
  }

  // Timer logic
  function start() {
    if (isTimerRunning) return;
    isTimerRunning = true;
    
    if (audioCtx && audioCtx.state === 'suspended') {
      audioCtx.resume();
    }

    render();
    saveLocalState();

    const startTime = Date.now();
    const startSecs = currentSecs;

    intervalId = setInterval(() => {
      const delta = Math.floor((Date.now() - startTime) / 1000);
      currentSecs = Math.max(0, startSecs - delta);
      render();

      if (currentSecs <= 0) {
        completeSession();
      }
    }, 1000);

    // Sync state to sidebar timer card
    syncTimerToStoreState();
  }

  function pause() {
    if (!isTimerRunning) return;
    isTimerRunning = false;
    if (intervalId) {
      clearInterval(intervalId);
      intervalId = null;
    }
    
    // Save focused elapsed time if focused mode is running
    const activeTaskId = TodoStore.getActiveFocusTodoId();
    if (activeMode === 'focus' && activeTaskId) {
      const cachedTimer = TodoStore.getTimerState();
      if (cachedTimer && cachedTimer.secondsRemaining) {
        const timeSpent = cachedTimer.secondsRemaining - currentSecs;
        if (timeSpent > 0) {
          TodoStore.addFocusTime(activeTaskId, timeSpent);
        }
      }
    }

    render();
    saveLocalState();
    syncTimerToStoreState();
  }

  function reset() {
    pause();
    FOCUS_SECS = getCustomTime('vercel-custom-focus', 25 * 60);
    BREAK_SECS = getCustomTime('vercel-custom-break', 5 * 60);
    currentSecs = activeMode === 'focus' ? FOCUS_SECS : BREAK_SECS;
    render();
    saveLocalState();
    syncTimerToStoreState();
  }

  function completeSession() {
    pause();
    playCompletionChime();

    const activeTaskId = TodoStore.getActiveFocusTodoId();

    if (activeMode === 'focus') {
      if (activeTaskId) {
        TodoStore.addFocusTime(activeTaskId, FOCUS_SECS);
        const task = TodoStore.getTodos().find(t => t.id === activeTaskId);
        window.dispatchEvent(new CustomEvent('toast:show', {
          detail: { message: `Completed focus session on: "${task ? task.title : 'Task'}"`, type: 'success' }
        }));
      } else {
        window.dispatchEvent(new CustomEvent('toast:show', {
          detail: { message: `Completed focus session!`, type: 'success' }
        }));
      }

      // Switch to break
      setTimerDuration('break');
    } else {
      window.dispatchEvent(new CustomEvent('toast:show', {
        detail: { message: `Break is over, let's start focusing!`, type: 'info' }
      }));
      setTimerDuration('focus');
    }
  }

  function setTimerDuration(mode, secsVal = null) {
    activeMode = mode;
    FOCUS_SECS = getCustomTime('vercel-custom-focus', 25 * 60);
    BREAK_SECS = getCustomTime('vercel-custom-break', 5 * 60);
    
    if (secsVal) {
      currentSecs = secsVal;
    } else {
      currentSecs = mode === 'focus' ? FOCUS_SECS : BREAK_SECS;
    }

    pause();
    render();
    saveLocalState();
    syncTimerToStoreState();
  }

  function saveLocalState() {
    const activeTaskId = TodoStore.getActiveFocusTodoId();
    TodoStore.setTimerState({
      isRunning: isTimerRunning,
      currentMode: activeMode,
      secondsRemaining: currentSecs,
      endTime: isTimerRunning ? Date.now() + (currentSecs * 1000) : null,
      currentTaskId: activeTaskId
    });
  }

  // Sync state variables to standard TodoStore timer state
  function syncTimerToStoreState() {
    const activeTaskId = TodoStore.getActiveFocusTodoId();
    TodoStore.setTimerState({
      isRunning: isTimerRunning,
      currentMode: activeMode,
      secondsRemaining: currentSecs,
      endTime: isTimerRunning ? Date.now() + (currentSecs * 1000) : null,
      currentTaskId: activeTaskId
    });
    // Trigger todo change event to coordinate timers across sections
    window.dispatchEvent(new CustomEvent('todo:change'));
  }

  // Synchronise state from Sidebar Timer Card changes
  function syncFromStoreState() {
    const saved = TodoStore.getTimerState();
    if (saved) {
      activeMode = saved.currentMode || 'focus';
      currentSecs = saved.secondsRemaining;
      
      // If store is running but local is not, trigger play
      if (saved.isRunning && !isTimerRunning) {
        isTimerRunning = true;
        render();
        const startTime = Date.now();
        const startSecs = currentSecs;
        
        intervalId = setInterval(() => {
          const delta = Math.floor((Date.now() - startTime) / 1000);
          currentSecs = Math.max(0, startSecs - delta);
          render();

          if (currentSecs <= 0) {
            completeSession();
          }
        }, 1000);
      } else if (!saved.isRunning && isTimerRunning) {
        isTimerRunning = false;
        if (intervalId) {
          clearInterval(intervalId);
          intervalId = null;
        }
        render();
      } else {
        render();
      }
    }
  }

  // Bind Custom Timer click-to-edit triggers
  if (clockDisplay && editForm && editInput) {
    clockDisplay.addEventListener('click', () => {
      if (isTimerRunning) return;
      clockDisplay.classList.add('hidden');
      editForm.classList.remove('hidden');
      editForm.classList.add('flex');
      editInput.value = Math.round(currentSecs / 60);
      editInput.focus();
      editInput.select();
    });

    editForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const mins = Math.max(1, Math.min(180, parseInt(editInput.value) || 25));
      const secs = mins * 60;
      
      if (activeMode === 'focus') {
        FOCUS_SECS = secs;
        localStorage.setItem('vercel-custom-focus', secs.toString());
      } else {
        BREAK_SECS = secs;
        localStorage.setItem('vercel-custom-break', secs.toString());
      }
      
      currentSecs = secs;
      
      editForm.classList.add('hidden');
      editForm.classList.remove('flex');
      clockDisplay.classList.remove('hidden');
      
      render();
      syncTimerToStoreState();
    });

    editInput.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        editForm.classList.add('hidden');
        editForm.classList.remove('flex');
        clockDisplay.classList.remove('hidden');
      }
    });

    document.addEventListener('click', (e) => {
      if (!editForm.contains(e.target) && !clockDisplay.contains(e.target)) {
        if (!editForm.classList.contains('hidden')) {
          editForm.classList.add('hidden');
          editForm.classList.remove('flex');
          clockDisplay.classList.remove('hidden');
        }
      }
    });
  }

  // Bind Buttons Click Listeners
  if (controlBtn) {
    controlBtn.addEventListener('click', () => {
      if (isTimerRunning) {
        pause();
      } else {
        start();
      }
    });
  }

  if (resetBtn) resetBtn.addEventListener('click', reset);
  
  if (setFocusBtn) setFocusBtn.addEventListener('click', () => {
    FOCUS_SECS = getCustomTime('vercel-custom-focus', 25 * 60);
    setTimerDuration('focus', FOCUS_SECS);
  });
  if (setBreakBtn) setBreakBtn.addEventListener('click', () => {
    BREAK_SECS = getCustomTime('vercel-custom-break', 5 * 60);
    setTimerDuration('break', BREAK_SECS);
  });
  if (setLongBtn) setLongBtn.addEventListener('click', () => setTimerDuration('break', LONG_SECS));

  if (taskSelect) {
    taskSelect.addEventListener('change', () => {
      const selectedId = taskSelect.value;
      TodoStore.setActiveFocusTodoId(selectedId || null);
    });
  }

  // Event handlers for active tasks modifications
  window.addEventListener('focus-todo:change', () => {
    syncTaskDisplay();
    reset();
  });
  window.addEventListener('todo:change', () => {
    populateTasksList();
    syncFromStoreState();
  });

  // Watch tab switches
  window.addEventListener('hashchange', () => {
    const hash = window.location.hash || '#dashboard';
    if (hash !== '#pomodoro' && isTimerRunning) {
      if (audioCtx && audioCtx.state === 'running') {
        audioCtx.suspend();
      }
    } else if (hash === '#pomodoro' && isTimerRunning) {
      if (audioCtx && audioCtx.state === 'suspended') {
        audioCtx.resume();
      }
    }
  });

  // Boot Setup
  populateTasksList();
  render();
</script>
