---
// BackupDialog.astro
---

<div 
  id="backup-dialog" 
  class="fixed inset-0 z-50 hidden items-center justify-center p-4 sm:p-6"
  role="dialog"
  aria-modal="true"
  aria-labelledby="backup-dialog-title"
>
  <!-- Backdrop -->
  <div id="backup-dialog-backdrop" class="fixed inset-0 bg-canvas-soft/40 dark:bg-canvas-soft/60 backdrop-blur-sm transition-opacity duration-200"></div>

  <!-- Dialog Box (Level 5 shadow) -->
  <div class="relative w-full max-w-md overflow-hidden rounded-lg border border-hairline bg-canvas shadow-level-5 transition-all p-6 flex flex-col gap-5">
    
    <!-- Title -->
    <div class="flex items-start justify-between border-b border-hairline pb-3">
      <div>
        <h2 id="backup-dialog-title" class="font-sans text-base font-semibold text-ink">Settings & Backups.</h2>
        <p class="text-xs text-mute mt-0.5">Manage your local task database configuration.</p>
      </div>
      <button 
        id="backup-dialog-close"
        class="text-mute hover:text-ink focus:outline-none"
        aria-label="Close dialog"
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Export Action Card -->
    <div class="space-y-2">
      <h3 class="font-mono text-[10px] font-semibold uppercase tracking-wider text-mute">Export Database.</h3>
      <div class="p-3 bg-canvas-soft border border-hairline rounded-md flex items-center justify-between gap-4">
        <div class="min-w-0">
          <p class="text-xs text-ink font-medium">Backup Backlog</p>
          <p class="text-[11px] text-mute truncate mt-0.5">Downloads all tasks, subtasks & timers.</p>
        </div>
        <button 
          id="btn-backup-export"
          class="h-8 px-3 rounded-full bg-primary text-on-primary font-sans text-xs font-medium hover:scale-[1.02] active:scale-[0.98] transition-all cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-link"
        >
          Export File
        </button>
      </div>
    </div>

    <!-- Import Action Card (Drag and Drop Zone) -->
    <div class="space-y-2">
      <h3 class="font-mono text-[10px] font-semibold uppercase tracking-wider text-mute">Import Backup.</h3>
      <div 
        id="import-drag-zone" 
        class="border-2 border-dashed border-hairline hover:border-brand-link rounded-lg p-5 text-center cursor-pointer transition-colors"
      >
        <svg class="mx-auto h-8 w-8 text-mute" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
        </svg>
        <p class="mt-2 text-xs font-semibold text-ink">Drag your JSON backup file here</p>
        <p class="text-[10px] text-mute mt-1">or click to browse local files</p>
        <input 
          type="file" 
          id="backup-file-input" 
          class="hidden" 
          accept=".json"
        />
      </div>
      <div id="import-error-msg" class="text-xs text-error font-medium mt-1.5 hidden"></div>
    </div>

    <!-- Reset database actions (Destructive warning card) -->
    <div class="border-t border-hairline pt-4 space-y-2">
      <h3 class="font-mono text-[10px] font-semibold uppercase tracking-wider text-mute">Danger Zone.</h3>
      <div class="p-3 bg-error-soft/10 border border-error-soft rounded-md flex items-center justify-between gap-4">
        <div class="min-w-0">
          <p class="text-xs text-error-deep font-semibold">Purge Local Storage</p>
          <p class="text-[11px] text-mute mt-0.5">This resets all data to factory settings.</p>
        </div>
        <button 
          id="btn-backup-reset"
          class="h-8 px-3 rounded-full border border-error bg-canvas text-error-deep hover:bg-error hover:text-on-primary font-sans text-xs font-medium transition-all cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-error"
        >
          Reset Data
        </button>
      </div>
    </div>

  </div>
</div>

<script>
  // @ts-nocheck
  import { TodoStore } from '../scripts/store.js';

  const dialog = document.getElementById('backup-dialog');
  const backdrop = document.getElementById('backup-dialog-backdrop');
  const closeBtn = document.getElementById('backup-dialog-close');
  const trigger = document.getElementById('backup-menu-trigger');
  
  const exportBtn = document.getElementById('btn-backup-export');
  const resetBtn = document.getElementById('btn-backup-reset');
  
  const dragZone = document.getElementById('import-drag-zone');
  const fileInput = document.getElementById('backup-file-input') as HTMLInputElement;
  const errorMsg = document.getElementById('import-error-msg');

  // Toggle Visibility
  function openDialog() {
    if (dialog) {
      dialog.classList.remove('hidden');
      dialog.classList.add('flex');
      if (errorMsg) errorMsg.classList.add('hidden');
    }
  }

  function closeDialog() {
    if (dialog) {
      dialog.classList.add('hidden');
      dialog.classList.remove('flex');
    }
  }

  // Trigger bindings
  if (trigger) trigger.addEventListener('click', openDialog);
  if (closeBtn) closeBtn.addEventListener('click', closeDialog);
  if (backdrop) backdrop.addEventListener('click', closeDialog);

  // Keyboard shortcut listener: close with Esc
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && dialog && !dialog.classList.contains('hidden')) {
      closeDialog();
    }
  });

  // Export action
  if (exportBtn) {
    exportBtn.addEventListener('click', () => {
      TodoStore.exportData();
      window.dispatchEvent(new CustomEvent('toast:show', {
        detail: { message: `Database backup exported!`, type: 'success' }
      }));
    });
  }

  // Purge / Reset database
  if (resetBtn) {
    resetBtn.addEventListener('click', () => {
      if (confirm('Are you absolutely sure you want to reset your database? This deletes all your custom tasks and cannot be undone.')) {
        localStorage.clear(); // Clear local storage completely
        window.location.reload(); // Reload to populate default tasks
      }
    });
  }

  // File loading parse
  function loadFile(file) {
    if (!file) return;
    
    const reader = new FileReader();
    reader.onload = function(e) {
      const content = e.target.result as string;
      const res = TodoStore.importData(content);
      
      if (res.success) {
        window.dispatchEvent(new CustomEvent('toast:show', {
          detail: { message: `Backlog restored successfully!`, type: 'success' }
        }));
        if (errorMsg) errorMsg.classList.add('hidden');
        closeDialog();
      } else {
        if (errorMsg) {
          errorMsg.textContent = res.error || 'Failed to restore backup.';
          errorMsg.classList.remove('hidden');
        }
      }
    };
    reader.readAsText(file);
  }

  // Browse click action
  if (dragZone && fileInput) {
    dragZone.addEventListener('click', () => {
      fileInput.click();
    });

    fileInput.addEventListener('change', () => {
      if (fileInput.files.length > 0) {
        loadFile(fileInput.files[0]);
      }
    });
  }

  // Drag and drop events
  if (dragZone) {
    ['dragenter', 'dragover'].forEach(eventName => {
      dragZone.addEventListener(eventName, (e) => {
        e.preventDefault();
        dragZone.classList.add('border-brand-link', 'bg-canvas-soft-2');
      }, false);
    });

    ['dragleave', 'drop'].forEach(eventName => {
      dragZone.addEventListener(eventName, (e) => {
        e.preventDefault();
        dragZone.classList.remove('border-brand-link', 'bg-canvas-soft-2');
      }, false);
    });

    dragZone.addEventListener('drop', (e) => {
      const dt = e.dataTransfer;
      const files = dt.files;
      if (files.length > 0) {
        loadFile(files[0]);
      }
    });
  }
</script>
